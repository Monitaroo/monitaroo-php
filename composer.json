{
    "name": "monitaroo/monitaroo",
    "description": "Official Monitaroo SDK for PHP - Logs, Metrics & Monitoring",
    "keywords": ["monitaroo", "logging", "metrics", "monitoring", "observability", "apm"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/Monitaroo/monitaroo-php",
    "authors": [
        {
            "name": "Monitaroo",
            "email": "support@monitaroo.com",
            "homepage": "https://monitaroo.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Monitaroo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monitaroo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=6"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
